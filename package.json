{
  "name": "rafn",
  "displayName": "Rafn",
  "description": "Rafn language support",
  "version": "0.1.2",
  "icon": "./icons/rafn.png",
  "publisher": "rafn-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafnlang/rafn-vscode"
  },
  "engines": {
    "vscode": "^1.119.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "rafn",
      "aliases": ["Rafn", "rafn"],
      "extensions": [".rafn"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/rafn-light.png",
        "dark": "./icons/rafn-dark.png"
      }
    }],
    "grammars": [{
      "language": "rafn",
      "scopeName": "source.rafn",
      "path": "./syntaxes/rafn.tmLanguage.json"
    }]
  }
}
