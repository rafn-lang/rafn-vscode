{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Rafn",
	"scopeName": "source.rafn",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#llvmBlock" },
		{ "include": "#llvmParen" },
		{ "include": "#strings" },
		{ "include": "#enumDecl" },
		{ "include": "#declarations" },
		{ "include": "#attributes" },
		{ "include": "#keywords" },
		{ "include": "#primitiveTypes" },
		{ "include": "#enumMembers" },
		{ "include": "#namespaces" },
		{ "include": "#parameters" },
		{ "include": "#functionCalls" },
		{ "include": "#typeNames" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.rafn",
					"match": "//.*$"
				},
				{
					"name": "comment.block.rafn",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},

		"llvmBlock": {
			"begin": "(#llvm)\\s*(\\{)",
			"beginCaptures": {
				"1": { "name": "keyword.control.directive.llvm.rafn" },
				"2": { "name": "punctuation.section.block.begin.rafn" }
			},
			"end": "(\\})",
			"endCaptures": {
				"1": { "name": "punctuation.section.block.end.rafn" }
			},
			"contentName": "meta.embedded.block.llvm.rafn",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#llvmRawString" },
				{ "include": "#llvmString" },
				{ "include": "#llvmContent" }
			]
		},

		"llvmParen": {
			"begin": "(#llvm)\\s*(\\()",
			"beginCaptures": {
				"1": { "name": "keyword.control.directive.llvm.rafn" },
				"2": { "name": "punctuation.section.group.begin.rafn" }
			},
			"end": "(\\))",
			"endCaptures": {
				"1": { "name": "punctuation.section.group.end.rafn" }
			},
			"contentName": "meta.embedded.block.llvm.rafn",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#llvmRawString" },
				{ "include": "#llvmString" },
				{ "include": "#llvmContent" }
			]
		},

		"llvmRawString": {
			"name": "string.quoted.other.raw.llvm.rafn",
			"begin": "#\"",
			"end": "\"#",
			"patterns": [
				{ "include": "#llvmEscapes" },
				{ "include": "#llvmContent" }
			]
		},

		"llvmString": {
			"name": "string.quoted.double.llvm.rafn",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "include": "#llvmEscapes" },
				{ "include": "#llvmContent" }
			]
		},

		"llvmEscapes": {
			"patterns": [
				{
					"name": "constant.character.escape.llvm.rafn",
					"match": "\\\\[0-9A-Fa-f]{2}"
				},
				{
					"name": "constant.character.escape.rafn",
					"match": "\\\\."
				}
			]
		},

		"llvmContent": {
			"patterns": [
				{
					"name": "keyword.control.llvm.instruction.rafn",
					"match": "\\b(alloca|store|load|call|ret|br|phi|getelementptr|bitcast|ptrtoint|inttoptr|malloc|free|align|declare|define|constant|global|private|unnamed_addr|add|sub|mul|icmp|fadd|fsub|fmul|fdiv)\\b"
				},
				{
					"name": "support.type.llvm.rafn",
					"match": "\\b(i[0-9]+|ptr|double|float|void)\\b"
				},
				{
					"name": "variable.other.global.llvm.rafn",
					"match": "@[A-Za-z_.$][A-Za-z0-9_.$]*"
				},
				{
					"name": "variable.other.register.llvm.rafn",
					"match": "%[A-Za-z_.$][A-Za-z0-9_.$]*"
				},
				{ "include": "#numbers" }
			]
		},

		"strings": {
			"patterns": [
				{
					"name": "string.quoted.other.raw.rafn",
					"begin": "#\"",
					"end": "\"#"
				},
				{
					"name": "string.quoted.double.format.rafn",
					"begin": "\\bf\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.rafn",
							"match": "\\\\."
						},
						{
							"name": "meta.interpolation.rafn",
							"begin": "\\{",
							"beginCaptures": {
								"0": { "name": "punctuation.section.interpolation.begin.rafn" }
							},
							"end": "\\}",
							"endCaptures": {
								"0": { "name": "punctuation.section.interpolation.end.rafn" }
							},
							"patterns": [{ "include": "$self" }]
						}
					]
				},
				{
					"name": "string.quoted.double.rafn",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.rafn",
							"match": "\\\\."
						}
					]
				}
			]
		},

		"enumDecl": {
			"begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
			"beginCaptures": {
				"1": { "name": "keyword.declaration.enum.rafn" },
				"2": { "name": "entity.name.type.enum.rafn" },
				"3": { "name": "punctuation.section.block.begin.rafn" }
			},
			"end": "(\\})",
			"endCaptures": {
				"1": { "name": "punctuation.section.block.end.rafn" }
			},
			"patterns": [
				{ "include": "#comments" },
				{
					"name": "variable.other.enummember.rafn",
					"match": "[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "punctuation.separator.comma.rafn",
					"match": ","
				}
			]
		},

		"namespacePath": {
			"patterns": [
				{
					"name": "keyword.operator.access.rafn",
					"match": "::"
				},
				{
					"name": "entity.name.namespace.rafn",
					"match": "[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},

		"declarations": {
			"patterns": [
				{
					"match": "\\b(package)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
					"captures": {
						"1": { "name": "keyword.control.package.rafn" },
						"2": { "patterns": [{ "include": "#namespacePath" }] }
					}
				},
				{
					"match": "\\b(require)\\s*(\\{)([^}]*)(\\})\\s*(from)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
					"captures": {
						"1": { "name": "keyword.control.import.rafn" },
						"2": { "name": "punctuation.definition.group.rafn" },
						"3": {
							"patterns": [
								{
									"name": "punctuation.separator.comma.rafn",
									"match": ","
								},
								{
									"name": "entity.name.type.import.rafn",
									"match": "[A-Za-z_][A-Za-z0-9_]*"
								}
							]
						},
						"4": { "name": "punctuation.definition.group.rafn" },
						"5": { "name": "keyword.control.import.rafn" },
						"6": { "patterns": [{ "include": "#namespacePath" }] }
					}
				},
				{
					"match": "\\b(class|struct)(!?)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.declaration.type.rafn" },
						"2": { "name": "storage.modifier.public.rafn" },
						"3": { "name": "entity.name.type.class.rafn" }
					}
				},
				{
					"match": "\\b(fn)(!?)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.declaration.function.rafn" },
						"2": { "name": "storage.modifier.public.rafn" },
						"3": { "name": "entity.name.function.rafn" }
					}
				},
				{
					"match": "\\b(val|var|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.variable.rafn" },
						"2": { "name": "variable.other.definition.rafn" }
					}
				}
			]
		},

		"attributes": {
			"patterns": [
				{
					"name": "storage.modifier.attribute.rafn",
					"match": "(?<=\\)\\s|\\))\\s*:[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},

		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.rafn",
					"match": "\\b(if|else|match|while|for|in|return|break|continue)\\b"
				},
				{
					"name": "variable.language.self.rafn",
					"match": "\\bself\\b"
				},
				{
					"name": "constant.language.rafn",
					"match": "\\b(true|false|null)\\b"
				},
				{
					"name": "constant.language.wildcard.rafn",
					"match": "\\b_\\b"
				}
			]
		},

		"primitiveTypes": {
			"name": "support.type.primitive.rafn",
			"match": "\\b(?:[iu](?:8|16|32|64|128|size)|f(?:32|64)|bool|char|void|Self|String)\\b"
		},

		"enumMembers": {
			"name": "variable.other.enummember.rafn",
			"match": "(?<=::)[A-Z][A-Za-z0-9_]*\\b(?!\\s*[<(])"
		},

		"namespaces": {
			"name": "entity.name.namespace.rafn",
			"match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*::)"
		},

		"parameters": {
			"name": "variable.parameter.rafn",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:(?!:))"
		},

		"functionCalls": {
			"name": "entity.name.function.call.rafn",
			"match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(?:<[^<>()]*>)?\\s*\\()"
		},

		"typeNames": {
			"name": "entity.name.type.rafn",
			"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
		},

		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.rafn",
					"match": "\\b0[xX][0-9A-Fa-f_]+\\b"
				},
				{
					"name": "constant.numeric.float.rafn",
					"match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.rafn",
					"match": "\\b\\d[\\d_]*\\b"
				}
			]
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.rafn",
					"match": "->"
				},
				{
					"name": "keyword.operator.fat-arrow.rafn",
					"match": "=>"
				},
				{
					"name": "keyword.operator.variadic.rafn",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.comparison.rafn",
					"match": "==|!=|<=|>="
				},
				{
					"name": "keyword.operator.logical.rafn",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.access.rafn",
					"match": "::|\\."
				},
				{
					"name": "keyword.operator.reference.rafn",
					"match": "&"
				},
				{
					"name": "keyword.operator.assignment.rafn",
					"match": "="
				},
				{
					"name": "keyword.operator.arithmetic.rafn",
					"match": "[+\\-*/%]"
				}
			]
		},

		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.colon.rafn",
					"match": ":"
				},
				{
					"name": "punctuation.separator.comma.rafn",
					"match": ","
				},
				{
					"name": "punctuation.definition.group.rafn",
					"match": "[(){}\\[\\]<>]"
				}
			]
		}
	}
}